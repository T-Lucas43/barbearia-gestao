    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./scripts/test-guard.mjs --test tests/*.test.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "format": "prettier --write app components lib scripts/*.ts tests next.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:lan": "tsx scripts/lan.ts",
    "backup": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "db:local:install": "npm install --prefix tmp/local-postgres-tools --no-audit --no-fund embedded-postgres@18.4.0-beta.17",
