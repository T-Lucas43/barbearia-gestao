# Ambiente local fictício. Nunca reutilize estes valores na hospedagem.
DATABASE_URL=postgres://barber:barber_local_only@127.0.0.1:5547/barber
APP_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=generate_a_random_secret_of_at_least_32_characters
BETTER_AUTH_URL=http://127.0.0.1:3000
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DATABASE_POOL_SIZE=5
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
INITIAL_LOCAL_PASSWORD=demo-local-2026
# Produção comercial: DEMO_MODE=false, build NEXT_PUBLIC_DEMO_MODE=false,
# senha inicial exclusiva >=16 caracteres, INITIAL_ADMIN_EMAIL e segredo aleatório.
INITIAL_ADMIN_EMAIL=
PUBLIC_SIGNUP_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false
# capture grava apenas em tmp/mailbox; é proibido em produção.
MAIL_TRANSPORT=capture
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=
OPERATOR_LEGAL_NAME=
# Backups externos ficam desligados até configurar destino, chave e cliente PG.
BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_UPLOAD_PREFIX=
BACKUP_UPLOAD_AUTH=
# Prefixo HTTPS com suporte a PUT; autorização só em cabeçalho, nunca na URL.
# Cliente pg_dump deve ter versão compatível com o servidor.
PG_BIN_DIR=
# Ensaio automatizado aceita somente PostgreSQL em loopback.
RESTORE_TEST_DATABASE_URL=
# WhatsApp manual não precisa destas credenciais. Integração automática opcional:
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_CANCELLATION=
WHATSAPP_TEMPLATE_RESCHEDULE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
