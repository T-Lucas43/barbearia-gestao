    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
